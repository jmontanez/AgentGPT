# Claude API key (HOOKDRAFT_ANTHROPIC_API_KEY is read first if set)
ANTHROPIC_API_KEY=
HOOKDRAFT_ANTHROPIC_API_KEY=
# Set to 1 to return a sample script without calling the API (for UI work and demos)
HOOKDRAFT_MOCK=

# Public site address, used in sign-in emails and Stripe redirects (e.g. https://hookdraft.app)
NEXT_PUBLIC_SITE_URL=

# Supabase (sign-in and usage). Leave all three empty to run locally without accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SECRET_KEY=

# Stripe (use test-mode keys until launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
